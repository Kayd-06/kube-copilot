# Kube Copilot — copy this file to .env and fill in your key:
#   cp .env.example .env

# --- LLM (OpenAI-compatible) ---
# Default provider is Groq: fast, and the free tier is enough for local demos.
# Create a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Other OpenAI-compatible backends also work — just change the three vars above:
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1
#            LLM_MODEL=gpt-4o-mini
#            LLM_API_KEY=sk-...
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1
#            LLM_MODEL=llama3.2
#            LLM_API_KEY=ollama

# --- Kubernetes ---
# Leave unset to use ~/.kube/config (the kind cluster from `make cluster-up`).
# K8S_KUBECONFIG=/home/you/.kube/config
# Set true only when the backend itself runs as a pod inside the cluster.
# `make helm-install` sets this automatically (and auto-detects the ServiceAccount token).
K8S_IN_CLUSTER=false
LOG_TAIL_LINES=200

# --- Frontend ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Used by the Next.js app (browser talks to the API on your machine):
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- RAG / Qdrant ---
# Default: the Docker Compose service (`make qdrant-up`).
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# For tests or a no-Docker laptop, use an in-memory or on-disk store instead:
#   QDRANT_URL=:memory:
#   QDRANT_PATH=.qdrant
#   (leave QDRANT_URL empty or set it to "path" when using QDRANT_PATH)
QDRANT_COLLECTION_RUNBOOKS=runbooks
QDRANT_COLLECTION_INCIDENTS=incidents
# Embedding backend: fastembed (default, CPU, downloads BAAI/bge-small-en-v1.5
# on first ingest) or fake (deterministic hash vectors, used in tests).
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=5
RAG_ENABLED=true
# Leave empty to auto-discover knowledge/runbooks at the repo root.
# KNOWLEDGE_DIR=/absolute/path/to/knowledge/runbooks

# --- Prometheus / anomaly detection (Phase 3) ---
# Default is the port-forward from `make metrics-forward`.
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT=3.0
# Leave empty to use backend/models/isolation_forest.joblib (created by `make train`).
# ANOMALY_MODEL_PATH=/absolute/path/to/isolation_forest.joblib
# Optional background scorer. Leave false on a low-spec laptop.
ANOMALY_POLLER_ENABLED=false
ANOMALY_POLL_INTERVAL_SECONDS=30
ANOMALY_WINDOW_SECONDS=180
ANOMALY_STEP_SECONDS=15
# ANOMALY_SCORE_THRESHOLD=
