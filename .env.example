# Kube Copilot — copy this file to .env and fill in your key:
#   cp .env.example .env

# --- LLM (OpenAI-compatible) ---
# Default provider is Groq: fast, and the free tier is enough for local demos.
# Create a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Other OpenAI-compatible backends also work — just change the three vars above:
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1
#            LLM_MODEL=gpt-4o-mini
#            LLM_API_KEY=sk-...
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1
#            LLM_MODEL=llama3.2
#            LLM_API_KEY=ollama

# --- Kubernetes ---
# Leave unset to use ~/.kube/config (the kind cluster from `make cluster-up`).
# K8S_KUBECONFIG=/home/you/.kube/config
# Set true only when the backend itself runs as a pod inside the cluster.
K8S_IN_CLUSTER=false
LOG_TAIL_LINES=200

# --- Frontend ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Used by the Next.js app (browser talks to the API on your machine):
NEXT_PUBLIC_API_URL=http://localhost:8000
