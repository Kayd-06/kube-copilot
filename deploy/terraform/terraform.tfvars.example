# Copy to terraform.tfvars (gitignored) and fill in before applying.
# This module is intentionally not applied in CI.

aws_region    = "us-east-1"
instance_type = "t3.small"   # use t3.micro only if you must stay on the free tier
ssh_cidr      = "x.x.x.x/32" # your public IP
llm_api_key   = "gsk_..."
image_tag     = "0.4.0"
